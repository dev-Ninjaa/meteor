# Deployment Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Private key for deployment (without 0x prefix or with)
PRIVATE_KEY=your_private_key_here

# Deployer address (optional - derived from PRIVATE_KEY if not set)
DEPLOYER_ADDRESS=

# Monad Testnet RPC
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Monad Mainnet RPC (for production)
# MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz

# Local Anvil RPC (for testing)
# LOCAL_RPC_URL=http://localhost:8545

# Etherscan/Blockscout API key for verification (optional)
# ETHERSCAN_API_KEY=your_api_key