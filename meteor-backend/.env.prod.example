# Production Environment Variables
# Copy to .env.prod and fill in values

# Application
NODE_ENV=production
PORT=4000
API_PREFIX=api
API_VERSION=1

# Database
POSTGRES_PASSWORD=your-strong-postgres-password

# Redis (no password by default, add REDIS_PASSWORD if needed)
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-strong-jwt-secret-min-32-chars
JWT_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# Monad
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_ESCROW_CONTRACT_ADDRESS=0xD06122a48bcAfe76E4eAA8CE8922b20a709AA26d

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Pinata IPFS Storage
PINATA_API_KEY=1cfba9a4a9a07047adde
PINATA_SECRET_KEY=c1e579534584e692d69641a9d162684e16bfbc740ed5b40eecef040e61adceb1
PINATA_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..s-z97ppfCaFDJWIXqcCvegW9TzPLjp24M7iYxNGaH4U

# CORS - set to your frontend domain in production
CORS_ORIGIN=https://your-frontend-domain.com

# Logging
LOG_LEVEL=warn